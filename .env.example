# Prefer copying backend/.env.example and frontend/.env.example for full local setup.
# Minimal shared defaults used by some local scripts:

DATABASE_URL=postgresql://squidflow:squidflow@localhost:5433/squidflow?schema=public
# Matches Vite proxy target (frontend/vite.config.ts → http://localhost:3001).
PORT=3001
SESSION_TTL_SECONDS=86400
