DATABASE_URL=postgresql://squidflow:squidflow@localhost:5433/squidflow?schema=public
PORT=3000
SESSION_TTL_SECONDS=86400
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:squidflow@localhost

# Google Geocoding API (Backend only; never expose to Frontend / Git).
GOOGLE_GEOCODING_API_KEY=

# Comma-separated browser origins. Production must set this for CORS.
# Example: https://app.example.com
FRONTEND_ORIGIN=

# Set to 1 when Backend sits behind a reverse proxy (client IP for rate limits).
TRUST_PROXY=

# Optional rate-limit overrides. Production defaults are tighter than development.
# LOGIN_RATE_LIMIT_MAX=
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=
# LOGIN_MAX_FAILURES=
# LOGIN_FAILURE_WINDOW_SECONDS=
# HIGH_RISK_RATE_LIMIT_MAX=
# HIGH_RISK_RATE_LIMIT_WINDOW_SECONDS=
